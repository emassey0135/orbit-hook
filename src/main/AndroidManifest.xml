<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets this app ask to be Backtalk's braille display; Backtalk uses it once the user allows it. -->
    <uses-permission android:name="fyi.quin.backtalk.permission.BRAILLE_DISPLAY" />
    <queries>
        <package android:name="com.orbit.screenreader" />
        <package android:name="fyi.quin.backtalk" />
    </queries>
    <application android:label="Satellite Hook" android:hasCode="true">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="Part of Satellite. Keeps Orbit's screen reader out of self-voicing apps and apps Backtalk reads, gives Backtalk the Orbit's keys as a braille display, and fixes Orbit's alarm clock and updater" />
        <meta-data android:name="xposedminversion" android:value="93" />

        <!-- The Orbit's keys as a braille display for Backtalk; only Backtalk can bind it. -->
        <service
            android:name=".OrbitDisplayService"
            android:exported="true"
            android:permission="fyi.quin.backtalk.permission.BIND_BRAILLE_DISPLAY">
            <intent-filter>
                <action android:name="fyi.quin.backtalk.action.BRAILLE_DISPLAY" />
            </intent-filter>
        </service>

        <receiver android:name=".ConnectReceiver" android:exported="true" />
    </application>
</manifest>
