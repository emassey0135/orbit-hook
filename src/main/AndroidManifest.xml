<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets Backtalk use the Orbit's keys as a braille display. Grant it with
         adb shell pm grant dev.emassey0135.orbithook fyi.quin.backtalk.permission.BRAILLE_DISPLAY -->
    <uses-permission android:name="fyi.quin.backtalk.permission.BRAILLE_DISPLAY" />
    <queries>
        <package android:name="com.orbit.screenreader" />
        <package android:name="fyi.quin.backtalk" />
    </queries>
    <application android:label="Orbit screen reader hook" android:hasCode="true">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="Keeps Orbit's screen reader out of self-voicing apps and apps another screen reader handles, and gives Backtalk the Orbit's keys as a braille display" />
        <meta-data android:name="xposedminversion" android:value="93" />

        <!-- The Orbit's keys as a braille display for Backtalk; only Backtalk can bind it. -->
        <service
            android:name=".OrbitDisplayService"
            android:exported="true"
            android:permission="fyi.quin.backtalk.permission.BIND_BRAILLE_DISPLAY">
            <intent-filter>
                <action android:name="fyi.quin.backtalk.action.BRAILLE_DISPLAY" />
            </intent-filter>
        </service>

        <receiver android:name=".ConnectReceiver" android:exported="true" />
    </application>
</manifest>
